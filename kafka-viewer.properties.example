# ============================================================
# kafka-viewer canonical configuration format
# ============================================================
# Use kafka.* properties for Kafka connection/security.
# Use schema.registry.* for optional Schema Registry.
#
# Java/Spring-style aliases may be accepted by the parser, but this
# file documents the canonical naming convention.

# ============================================================
# Required Kafka setting
# ============================================================
kafka.bootstrap.servers=localhost:9092

# ============================================================
# Common Kafka consumer/client settings (optional)
# ============================================================
kafka.api.version=auto
kafka.auto.offset.reset=latest
kafka.client.id=kafka-viewer
kafka.consumer.timeout.ms=1500
kafka.fetch.max.bytes=52428800
kafka.fetch.max.wait.ms=500
kafka.fetch.min.bytes=1
kafka.max.poll.records=500
kafka.request.timeout.ms=40000
kafka.session.timeout.ms=10000
# kafka.socks5.proxy=127.0.0.1:1080

# Commits remain disabled by kafka-viewer.
kafka.enable.auto.commit=false

# ============================================================
# Security protocol
# ============================================================
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
kafka.security.protocol=PLAINTEXT

# ============================================================
# SASL (optional)
# ============================================================
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI | OAUTHBEARER
# kafka.sasl.mechanism=PLAIN

# Option 1: explicit username/password (PLAIN/SCRAM)
# kafka.sasl.username=YOUR_USERNAME
# kafka.sasl.password=YOUR_PASSWORD

# Option 2: JAAS-style string (PLAIN/SCRAM)
# kafka.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username="YOUR_USERNAME" password="YOUR_PASSWORD";

# ============================================================
# SSL/TLS options (direct PEM)
# ============================================================
# kafka.ssl.cafile=C:\path\to\ca.pem
# kafka.ssl.certfile=C:\path\to\client-cert.pem
# kafka.ssl.keyfile=C:\path\to\client-key.pem
# kafka.ssl.password=YOUR_KEY_PASSWORD
# kafka.ssl.key.password=YOUR_KEY_PASSWORD

# https enables hostname verification; none/empty disables it.
# kafka.ssl.endpoint.identification.algorithm=https
kafka.ssl.check.hostname=true
# kafka.ssl.protocol=TLSv1.2
# kafka.ssl.cipher.suites=TLS_AES_128_GCM_SHA256
# kafka.ssl.crlfile=C:\path\to\client.crl

# ============================================================
# Truststore/keystore options (enterprise Java style)
# ============================================================
# kafka.ssl.truststore.location=C:\path\to\truststore.jks
# kafka.ssl.truststore.type=JKS
# kafka.ssl.truststore.password=YOUR_TRUSTSTORE_PASSWORD
# kafka.ssl.truststore.cert.alias=YOUR_TRUSTSTORE_ALIAS

# kafka.ssl.keystore.location=C:\path\to\client.p12
# kafka.ssl.keystore.type=PKCS12
# kafka.ssl.keystore.password=YOUR_KEYSTORE_PASSWORD
# kafka.ssl.key.password=YOUR_KEY_PASSWORD
# kafka.ssl.keystore.key.alias=YOUR_KEY_ALIAS

# For PEM keystore location with separate key file:
# kafka.ssl.keystore.location=C:\path\to\client-cert.pem
# kafka.ssl.keystore.type=PEM
# kafka.ssl.keystore.key.location=C:\path\to\client-key.pem

# ============================================================
# Schema Registry / Confluent Avro (optional)
# ============================================================
# The URL is optional. If omitted, kafka-viewer falls back to raw/string/JSON display.
# HTTPS is supported without Basic Authentication when the server certificate is trusted.
# HTTP is also supported without authentication unless you explicitly configure it.
# schema.registry.url=https://schema-registry.company.com:8082

# Optional - custom CA for private/internal certificate authorities.
# schema.registry.ssl.ca.location=C:\path\to\company-ca.pem

# Optional - certificate verification. Default is true.
# schema.registry.ssl.verify=true
# schema.registry.ssl.verify=false

# Optional - compatibility property only. The current Python/Confluent stack does not expose an equivalent
# revocation control mechanism for ssl.no.revoke, so this is accepted as a compatibility setting only when false.
# schema.registry.ssl.no.revoke=false

# Optional - Basic Authentication is independent of HTTPS and remains optional.
# schema.registry.basic.auth.user.info=YOUR_USERNAME:YOUR_PASSWORD

# Optional - Schema Registry client certificate / private key (if used)
# schema.registry.ssl.certificate.location=C:\path\to\client-cert.pem
# schema.registry.ssl.key.location=C:\path\to\client-key.pem
# schema.registry.ssl.key.password=YOUR_KEY_PASSWORD
